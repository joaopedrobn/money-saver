{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "money-saver-sync-lab",
  "main": "../.local/worker-dist/index.js",
  "no_bundle": true,
  "build": { "command": "npm run build:worker", "cwd": ".." },
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "vars": { "LAB_ONLY": "true", "SUPABASE_URL": "http://127.0.0.1:54321" },
  "dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "http" },
}
