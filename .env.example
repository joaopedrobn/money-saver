# Optional. Local financial storage remains active even when Auth is enabled.
VITE_SUPABASE_AUTH_ENABLED=false
VITE_SUPABASE_URL=
# Use only the publishable key (sb_publishable_...). Never a secret/service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional override; omit to use the current origin + /. Never use an empty override.
# VITE_SUPABASE_AUTH_REDIRECT_URL=http://127.0.0.1:5173/
# Public deployment gates. Keep disabled until remote validation is approved and passes.
VITE_REMOTE_SYNC_ENABLED=false
VITE_SYNC_ALLOWED_USER_IDS=
VITE_SYNC_API_URL=https://money-saver.quem-votar-jp.workers.dev/sync-api
