# Optional. Local financial storage remains active even when Auth is enabled.
VITE_SUPABASE_AUTH_ENABLED=false
VITE_SUPABASE_URL=
# Use only the publishable key (sb_publishable_...). Never a secret/service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Exact app origin + pathname, without query/hash. Allowlist it in Supabase Auth.
# Example for development: http://127.0.0.1:5173/
VITE_SUPABASE_AUTH_REDIRECT_URL=
